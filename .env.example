# Copy to .env when needed. Never commit .env or put credentials in URLs.
# Keys can also be saved from the local setup page (data/secrets.json);
# environment variables take priority. Configure addresses/models in the UI or here.
READER_API_KEY=
# Set this for a separate image service; never reuse an unrelated provider's key.
# READER_IMAGE_API_KEY=

# Optional overrides. Uncomment only settings you want managed by environment.
# 正文接入必须显式选择：api / agy / codex，不会自动回退。
# READER_TEXT_PROVIDER=api
# 图片接入：api / agy / none；默认 api（沿用正文模型）。
# READER_IMAGE_PROVIDER=api
# READER_API_BASE_URL=https://your-model-service.example/v1
# READER_TEXT_MODEL=your-text-model
# READER_IMAGE_MODEL=your-vision-model
# READER_IMAGE_API_BASE_URL=https://your-image-service.example/v1
# 默认译文语言（页面「译为」未选择时使用）：zh-CN / zh-TW / en / ja / ko / fr / de / es / pt-BR / ru
# READER_TARGET_LANGUAGE=zh-CN
# X 登录墙时使用的公开接口；可指向自建 FxTwitter，设为 off 则关闭。
# READER_X_API=https://api.fxtwitter.com
# IMAGE_CONCURRENCY=2
# PORT=4317
# READER_DATA_DIR=./data
# AGY_BIN=/absolute/path/to/agy
# CODEX_BIN=/absolute/path/to/codex
