{
  "name": "quiet-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地文章翻译与 Markdown 阅读器",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/xsk-code/quiet-reader.git" },
  "homepage": "https://github.com/xsk-code/quiet-reader#readme",
  "bugs": "https://github.com/xsk-code/quiet-reader/issues",
  "keywords": ["article-reader", "translator", "markdown", "local-first", "openai-compatible", "chinese"],
  "scripts": {
    "start": "node server.mjs",
    "start:open": "node scripts/start-open.mjs",
    "demo": "node scripts/demo.mjs",
    "verify": "node scripts/demo.mjs --verify",
    "test": "node --test",
    "doctor": "node scripts/doctor.mjs",
